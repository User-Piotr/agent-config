{
  "syncClaudeAiSkills": false,
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CAVEMAN_DEFAULT_MODE": "lite",
    "CHECKPOINT_DISABLE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(terraform init *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)",
      "Bash(terraform fmt *)",
      "Bash(terraform providers *)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(terraform version *)",
      "Bash(terraform graph *)",
      "Bash(terraform state list *)",
      "Bash(terraform state show *)",
      "Bash(tofu init *)",
      "Bash(tofu validate *)",
      "Bash(tofu plan *)",
      "Bash(tofu fmt *)",
      "Bash(tofu providers *)",
      "Bash(tofu show *)",
      "Bash(tofu output *)",
      "Bash(tofu version *)",
      "Bash(tofu graph *)",
      "Bash(tofu state list *)",
      "Bash(tofu state show *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Edit(~/.aws/credentials)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.gitconfig)",
      "Read(**/.env)",
      "Edit(**/.env)"
    ],
    "ask": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform state rm *)",
      "Bash(terraform state mv *)",
      "Bash(terraform state push *)",
      "Bash(terraform workspace delete *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(tofu import *)",
      "Bash(tofu force-unlock *)",
      "Bash(tofu state rm *)",
      "Bash(tofu state mv *)",
      "Bash(tofu state push *)",
      "Bash(tofu workspace delete *)",
      "Bash(terragrunt apply *)",
      "Bash(terragrunt destroy *)",
      "Bash(terragrunt run-all apply *)",
      "Bash(terragrunt run-all destroy *)",
      "Bash(helmfile apply *)",
      "Bash(helmfile sync *)",
      "Bash(helmfile destroy *)",
      "Bash(helmfile delete *)",
      "Bash(argocd app sync *)",
      "Bash(argocd app delete *)",
      "Bash(argocd app rollback *)",
      "Bash(argocd app set *)",
      "Bash(argocd app patch *)",
      "Bash(argocd app create *)",
      "Bash(argocd app terminate-op *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret set *)",
      "Bash(gh workflow run *)",
      "Bash(az repos pr create *)"
    ]
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "claude-api": "off",
    "keybindings-help": "off",
    "run": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/block-mutations.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/scripts/block-mcp-mutations.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/caveman-statusline.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "morph@morph": true,
    "devops@morph": true
  },
  "extraKnownMarketplaces": {
    "morph": {
      "source": {
        "source": "github",
        "repo": "User-Piotr/morph"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "registry.terraform.io",
        "releases.hashicorp.com",
        "*.amazonaws.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "dev.azure.com",
        "*.dev.azure.com",
        "login.microsoftonline.com",
        "management.azure.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.kube/cache",
        "~/.aws/cli/cache",
        "~/.aws/sso/cache",
        "~/.azure",
        "~/.terraform.d",
        "~/.cache",
        "~/.local/state"
      ]
    },
    "excludedCommands": [
      "terraform init *",
      "terraform validate *",
      "terraform plan *",
      "terraform fmt *",
      "terraform providers *",
      "terraform show *",
      "terraform output *",
      "terraform version *",
      "terraform graph *",
      "terraform state list *",
      "terraform state show *",
      "tofu init *",
      "tofu validate *",
      "tofu plan *",
      "tofu fmt *",
      "tofu providers *",
      "tofu show *",
      "tofu output *",
      "tofu version *",
      "tofu graph *",
      "tofu state list *",
      "tofu state show *"
    ]
  },
  "effortLevel": "high",
  "agent": "morph:morph",
  "plansDirectory": ".claude/plans",
  "theme": "dark-daltonized"
}
